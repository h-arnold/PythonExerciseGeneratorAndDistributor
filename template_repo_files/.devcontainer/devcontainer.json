{
  "name": "Python Tutor Student Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",

  // Configure VS Code settings
  "customizations": {
    "vscode": {
      // Extensions to install - minimal set for student exercises
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "donjayamanne.vscode-default-python-kernel"
      ],

      // VS Code settings
      "settings": {
        // Python configuration
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": [
          "tests",
          "-q"
        ],
        "python.analysis.typeCheckingMode": "basic",
        "python.formatting.provider": "none",

        // Copilot chat features
        "chat.disableAIFeatures": true,
        
        
        // Editor configuration
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        
        // File exclusions - we keep a minimal set of folders visible to avoid extraneous cognitive load
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.pytest_cache": true,
          "**/.github": true,
          "**/.git": true,
          "**/.svn": true,
          "**/.hg": true,
          "**/.DS_Store": true,
          "**/Thumbs.db": true,
          "**/*.crswap": true,
          "**/scripts": true,
          "**/tests": true,
          "**/exercise_runtime_support": true,
          "exercise_metadata": true,
          "exercise_metadata/**": true,
          "**/exercise_metadata": true,
          "**/exercise_metadata/**": true,
          "exercises/**/exercise.json": true,
          "**/.devcontainer": true,
          ".devcontainer": true,
          ".venv": true,
          "**/.venv": true,
          "pyproject.toml": true,
          ".gitignore": true,
          "pytest.ini": true,
          "uv.lock": true,
          ".classroom50.yaml": true
        },
        
        // Jupyter configuration
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "notebook.output.scrolling": true,
        // Ensures we don't end up stepping into 3rd party libraries - not relevant for students.
        "jupyter.debugJustMyCode": true,
        // The main thing students benefit from is being able to see the contents and state of variables as they step through the code.
        "jupyter.showVariableViewWhenDebugging": true,
        // If a student forgets to set a breakpoint, the debugger will still allow them to step-through
        "jupyter.stopOnFirstLineWhileDebugging": true,
        
        // Workbench configuration - keep environment simple
        "workbench.startupEditor": "none",
        "workbench.tips.enabled": false,
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        "workbench.remoteIndicator.showExtensionRecommendations": false,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "workbench.sideBar.location": "left",
        "workbench.panel.opensMaximized": "never",
        "workbench.statusBar.visible": false,
        "zenMode.silentNotifications": true
        }
    }
  },


  // Post-create command to install the exercise package if pyproject.toml exists.
  // $HOME/.local/bin is prepended so the `uv` binary installed via
  // `pip install --user` is found even when it is not on the default PATH.
  // `python -m uv` is intentionally avoided: the pip-installed uv ships a
  // binary without a matching importable module, so `python -m uv` fails
  // while the `uv` binary works.
  "postCreateCommand": "export PATH=$HOME/.local/bin:$PATH; command -v uv >/dev/null 2>&1 || python3 -m pip install --user uv==0.8.22; uv sync",
  // Startup lives in a script rather than an inline shell chain: an inline
  // `nohup ... &` reports success as soon as the shell forks, so a watchdog
  // that died immediately was indistinguishable from a healthy one. The script
  // syncs dependencies, warns without failing when that fails, and confirms the
  // watchdog started. It is invoked via `bash` so the packaged template does
  // not depend on an executable bit surviving a Git checkout.
  "postStartCommand": "bash .devcontainer/post_start.sh",
  // Use the 'vscode' user which already exists in the base image
  "remoteUser": "vscode",

  // Environment variables
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },

  // Features to disable (keep minimal)
  "features": {}

}
